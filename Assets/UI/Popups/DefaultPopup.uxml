<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ProfileSavePopup" style="flex-grow: 1; position: absolute; height: 60%; width: 60%; top: 15%; left: 25%; flex-direction: row; align-content: auto; align-items: center; align-self: auto; justify-content: flex-start; background-color: rgb(36, 36, 36); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; visibility: visible; display: flex; border-left-color: rgb(226, 226, 226); border-right-color: rgb(226, 226, 226); border-top-color: rgb(226, 226, 226); border-bottom-color: rgb(226, 226, 226); flex-wrap: wrap; flex-shrink: 0; flex-basis: auto;">
        <ui:Label text="Confirm Template Name" name="Title" style="flex-grow: 1; flex-shrink: 0; height: 25%; justify-content: flex-start; align-self: flex-start; font-size: 125px; color: rgba(255, 255, 255, 0.84); -unity-text-align: upper-center; -unity-font-style: bold; top: auto;" />
        <ui:VisualElement name="Seperator" style="flex-grow: 0; background-color: rgb(24, 24, 24); height: 1px; width: 100%; flex-shrink: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; align-content: auto; align-self: flex-start; top: auto; margin-top: 1%; margin-right: 0%; margin-bottom: 1%; margin-left: 0%;" />
        <ui:TextField placeholder-text="Enter Name..." hide-placeholder-on-focus="false" keyboard-type="Default" max-length="20" password="false" auto-correction="false" multiline="false" emoji-fallback-support="false" style="height: 35%; flex-grow: 1; font-size: 100px; -unity-background-image-tint-color: rgb(255, 255, 255); align-items: stretch; justify-content: flex-end; align-self: center; flex-direction: row; flex-wrap: wrap;" />
        <ui:VisualElement name="Seperator" style="flex-grow: 0; background-color: rgb(24, 24, 24); height: 1px; width: 100%; flex-shrink: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; align-content: auto; align-self: stretch; top: auto; margin-top: 1%; margin-right: 0%; margin-bottom: 1%; margin-left: 0%; justify-content: center; align-items: flex-start; flex-direction: row;" />
        <ui:VisualElement name="OptionsBar" style="flex-grow: 1; background-size: 100% 100%; height: 25%; flex-shrink: 0; top: auto; flex-direction: row-reverse; flex-wrap: nowrap; align-items: auto; justify-content: space-around; align-self: center; align-content: center; border-left-color: rgb(255, 107, 107); border-right-color: rgb(255, 107, 107); border-top-color: rgb(255, 107, 107); border-bottom-color: rgb(255, 107, 107); margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%;">
            <ui:Button name="CreateBtn" style="position: relative; top: 0%; left: 0%; width: 30%; height: 100%; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.23); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 100%; color: rgb(255, 255, 255); -unity-font-style: bold; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; align-self: center; -unity-text-align: middle-center; white-space: nowrap; flex-direction: row; flex-shrink: -1; flex-basis: auto; flex-wrap: nowrap; justify-content: flex-end; align-content: center; align-items: stretch;">
                <ui:Label text="Create" style="width: auto; height: auto; font-size: 80%; -unity-text-align: middle-center; flex-grow: 1;" />
            </ui:Button>
            <ui:Button name="CancelBtn" style="position: relative; top: 0%; left: 0%; width: 30%; height: 100%; border-left-color: rgb(255, 107, 107); border-right-color: rgb(255, 107, 107); border-top-color: rgb(255, 107, 107); border-bottom-color: rgb(255, 107, 107); background-color: rgba(255, 107, 107, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 100%; color: rgb(255, 107, 107); -unity-font-style: bold; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; align-self: center; -unity-text-align: middle-center; white-space: nowrap; flex-direction: row; flex-shrink: -1; flex-basis: auto; flex-wrap: nowrap; justify-content: flex-end; align-content: center; align-items: stretch;">
                <ui:Label text="Cancel" style="width: auto; height: auto; font-size: 80%; -unity-text-align: middle-center; flex-grow: 1;" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
