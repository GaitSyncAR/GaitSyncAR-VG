                        <ui:Button text="[ 0 ]" name="XPos" style="height: 90%; width: 33%; background-color: rgba(240, 240, 240, 0.23); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(60, 60, 60); border-right-color: rgb(60, 60, 60); border-top-color: rgb(60, 60, 60); border-bottom-color: rgb(60, 60, 60); top: 5%; font-size: 50%; color: rgb(240, 240, 240);" />
