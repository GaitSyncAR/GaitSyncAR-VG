<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1; top: 0%; left: 0%; right: 0%; bottom: 0%; width: 100%; height: 100%;">
        <ui:VisualElement name="RemotePage" style="flex-grow: 1; top: 0%; left: 0%; right: 0%; bottom: 0%; width: 100%; height: 100%; display: flex;">
            <ui:Label text="Gait Sync Remote" name="Title" style="color: rgb(240, 240, 240); -unity-font-style: bold; width: 100%; height: 10%; font-size: 50%; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgba(255, 255, 255, 0.11); border-right-color: rgba(255, 255, 255, 0.11); border-top-color: rgba(255, 255, 255, 0.11); border-bottom-color: rgba(255, 255, 255, 0.11); left: 0%;">
                <ui:Button text="⚙️Settings" style="position: relative; top: 5%; left: 84.5%; width: 15%; height: 90%; border-left-color: rgba(60, 60, 60, 0); border-right-color: rgba(60, 60, 60, 0); border-top-color: rgba(60, 60, 60, 0); border-bottom-color: rgba(60, 60, 60, 0); background-color: rgba(188, 188, 188, 0.23); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
            </ui:Label>
            <ui:Label text="Current BPM:" name="BPM-Title" style="color: rgb(240, 240, 240); -unity-font-style: bold; width: 100%; height: 7%; font-size: 50%; -unity-text-align: upper-center; top: 2%;" />
            <ui:Label text="120" name="BPM-lbl" style="color: rgb(240, 240, 240); -unity-font-style: bold; width: 100%; height: 12%; font-size: 100%; -unity-text-align: upper-center; top: 2%;" />
            <ui:Button text="Slower ( - )" name="decrease" style="height: 48%; width: 50%; top: 5%; background-color: rgba(240, 240, 240, 0); border-left-color: rgba(149, 149, 149, 0.96); border-right-color: rgba(149, 149, 149, 0.96); border-top-color: rgba(149, 149, 149, 0.96); border-bottom-color: rgba(149, 149, 149, 0.96); border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 100%; color: rgb(240, 240, 240); align-items: auto; justify-content: flex-start; align-self: auto; align-content: auto;" />
            <ui:Button text="Faster ( + )" name="increase" style="height: 48%; width: 50%; top: 35.7%; background-color: rgba(240, 240, 240, 0); border-left-color: rgba(149, 149, 149, 0.96); border-right-color: rgba(149, 149, 149, 0.96); border-top-color: rgba(149, 149, 149, 0.96); border-bottom-color: rgba(149, 149, 149, 0.96); border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 100%; color: rgb(240, 240, 240); align-content: flex-start; align-self: auto; justify-content: flex-start; align-items: auto; position: absolute; left: 50%;" />
            <ui:Button text="[▶ START / STOP ]" name="StartStop" style="height: 16%; top: 4.7%; border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); background-color: rgb(51, 51, 51); color: rgb(240, 240, 240); font-size: 100%; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; width: 100%; left: 0%;" />
        </ui:VisualElement>
        <ui:VisualElement name="CalibrationPage" style="flex-grow: 1; top: 0%; left: 0%; right: 0%; bottom: 0%; width: 100%; height: 100%; visibility: visible; display: none;" />
    </ui:VisualElement>
</ui:UXML>
